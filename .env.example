# --- MongoDB ---
# Atlas connection string. Remember to allow your IP (or 0.0.0.0/0) under
# Atlas → Network Access, or connections fail with a TLS alert.
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/agro?retryWrites=true&w=majority"
MONGODB_DB="agro"

# --- Auth ---
# Long random string used to sign session cookies (REQUIRED in production)
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional overrides for the seeded credentials
# ADMIN_PASSWORD="..."
# CLIENT_PASSWORD="..."

# --- Daily data sync (Vercel Cron: CAI + ICE + RBI, 7 PM IST) ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily
CRON_SECRET="another-long-random-string"
